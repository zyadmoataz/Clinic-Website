# Backend REST URL (point to local mock-api or production server)
VITE_API_BASE_URL=http://localhost:5000/api

# Data transport mode:
# - auto: uses VITE_API_BASE_URL and falls back to browser mock adapter if unreachable
# - api: strict live HTTP mode only
# - mock: forces in-browser stateful mock adapter (ideal for static demos)
VITE_DATA_MODE=auto
